{
  "name": "claude-context-viewer",
  "version": "0.1.0",
  "description": "See what Claude Code actually loads into a session: every injected context layer, per project and per session, plus the health of the auto-memory",
  "license": "MIT",
  "author": "Vincent Caudron (https://github.com/Vincweb)",
  "homepage": "https://github.com/Vincweb/claude-context-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vincweb/claude-context-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/Vincweb/claude-context-viewer/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "context",
    "context-window",
    "system-prompt",
    "memory",
    "claude-md",
    "transcripts",
    "tokens",
    "cli",
    "viewer",
    "anthropic"
  ],
  "type": "module",
  "bin": {
    "claude-context-viewer": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx src/cli.ts",
    "dev:web": "vite",
    "build": "tsup && vite build",
    "lint": "eslint .",
    "type-check": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.6",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.2.2"
  }
}
